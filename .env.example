# ChainFlow — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Azure SQL Server connection string (ODBC Driver 18)
DATABASE_URL=mssql+pyodbc://YOUR_USER:YOUR_PASSWORD@YOUR_SERVER.database.windows.net:1433/YOUR_DB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&Connection+Timeout=30

# ── Tally / local services ─────────────────────────────────────────────────────
TALLY_URL=http://localhost:9000
CHAINFLOW_API_URL=http://localhost:8000
VENDOR_SIMULATOR_URL=http://localhost:8001
CHAINFLOW_TENANT_ID=1

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-oss-120b

# ── Azure Communication Services (Email) ──────────────────────────────────────
# Connection string from ACS resource → Keys blade
ACS_CONNECTION_STRING=endpoint=https://YOUR_RESOURCE.communication.azure.com/;accesskey=YOUR_BASE64_KEY
# Verified sender address on the ACS managed domain
ACS_EMAIL_SENDER=DoNotReply@YOUR_DOMAIN_ID.azurecomm.net
# Recipient — must be verified in Azure portal (sandbox mode)
TEST_EMAIL=your_email@example.com
# Internal owner / spend-approval notifications
OWNER_EMAIL=owner_email@example.com

# ── Azure Blob Storage ────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=chainflow-docs

# ── Azure Cosmos DB ───────────────────────────────────────────────────────────
COSMOS_CONNECTION_STRING=AccountEndpoint=https://YOUR_COSMOS.documents.azure.com:443/;AccountKey=YOUR_KEY;
COSMOS_DATABASE=chainflow
COSMOS_CONTAINER=agent-audit-log