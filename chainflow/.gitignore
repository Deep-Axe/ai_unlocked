# ChainFlow .gitignore

# Environment — never commit real keys
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Database (local SQLite)
*.db
*.sqlite3

# Virtual environments
venv/
.venv/
env/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
tally_sync.log

# Generated files (regenerate with create_template.py)
sample_data/inventory_template.xlsx

# Prompts / internal specs — not for public repo
prompts/

# Server log files
*.log
server*.log
